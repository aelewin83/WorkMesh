{
  "name": "relai",
  "version": "0.1.0",
  "private": true,
  "description": "Relai privacy-first encrypted labor marketplace monorepo.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm --parallel --filter @relai/api --filter @relai/web dev",
    "dev:api": "pnpm --filter @relai/api dev",
    "dev:web": "pnpm --filter @relai/web dev",
    "dev:web:mock": "pnpm --filter @relai/web dev:mock",
    "dev:web:api": "pnpm --filter @relai/web dev:api",
    "build": "pnpm -r build",
    "build:web:mock": "pnpm --filter @relai/web build:mock",
    "build:web:api": "pnpm --filter @relai/web build:api",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @relai/web test:api",
    "test:contracts": "pnpm --dir contracts test",
    "test:watch": "pnpm --filter @relai/web test:watch",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "typecheck": "npm --prefix apps/api run typecheck && npm --prefix packages/ui run typecheck",
    "verify": "pnpm typecheck && pnpm test:api && pnpm test:contracts && pnpm build:web:api && pnpm build:web:mock",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:reset": "node scripts/db.mjs reset",
    "db:test:reset": "node scripts/db.mjs test:reset",
    "indexer:live": "pnpm --filter @relai/indexer live",
    "db:start": "node scripts/db-service.mjs start",
    "db:stop": "node scripts/db-service.mjs stop",
    "db:logs": "node scripts/db-service.mjs logs",
    "db:status": "node scripts/db-service.mjs status"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.3"
}
